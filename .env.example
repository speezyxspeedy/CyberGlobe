# GEMINI_API_KEY: Gemini Forensic Analyst API — server-side only, NEVER sent to browser.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
# Used for CORS allowlist. Must not end with a trailing slash.
APP_URL=http://localhost:3000

# PORT: Node.js server listen port (default 3000).
PORT=3000

# DEMO_MODE: Set to "false" in production to disable demo data seeding.
# When true, all simulated events are visibly labeled "DEMO DATA" in the UI.
DEMO_MODE=true

# ── Optional live enrichment providers ───────────────────────────────────────
# Falls back to labeled DEMO DATA when unset.

# ABUSEIPDB_API_KEY: Live IP reputation lookups from AbuseIPDB.
# Get a free key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# MAXMIND_DB_PATH: Absolute path to MaxMind GeoLite2-City.mmdb for offline geolocation.
# Download from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# Leave empty to use the built-in approximate fallback.
MAXMIND_DB_PATH=

# CESIUM_ION_TOKEN: Cesium Ion access token for high-resolution terrain and imagery.
# Get a free token at https://ion.cesium.com/tokens
# Leave empty to use bundled NaturalEarthII tiles (no external dependency).
CESIUM_ION_TOKEN=

# ── Authentication & Security ─────────────────────────────────────────────────

# JWT_SECRET: Minimum 32-character random string used to sign API auth tokens.
# Generate with: openssl rand -hex 32
# Required for self-hosted FastAPI backend.
JWT_SECRET=

# ── Self-hosted FastAPI + PostgreSQL/PostGIS + Redis (Docker Compose) ─────────

# DATABASE_URL: Full PostgreSQL connection string (alternative to individual vars below).
# Example: postgresql://cybertrace_app:password@postgres:5432/cybertrace
DATABASE_URL=

# PostgreSQL connection parameters (used when DATABASE_URL is not set)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cybertrace
POSTGRES_USER=cybertrace_app
# POSTGRES_PASSWORD is REQUIRED for Docker Compose deployment.
POSTGRES_PASSWORD=

# Redis connection parameters
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL takes precedence if set.
REDIS_URL=

# FastAPI backend port (exposed from Docker container)
BACKEND_PORT=8000

# ── Optional tuning ───────────────────────────────────────────────────────────

# RETENTION_DAYS: How many days to retain raw event records before archiving.
# Default: 90
RETENTION_DAYS=90

# RATE_LIMIT_DEFAULT: Requests per minute per IP for general API endpoints.
# Default: 60
RATE_LIMIT_DEFAULT=60

# RATE_LIMIT_INGEST: Requests per minute per IP for /api/logs/ingest.
# Default: 10
RATE_LIMIT_INGEST=10
